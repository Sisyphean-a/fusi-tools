{
  "activationEvents": [
    "onView:fusi-tools.gitWorktree.view",
    "onCommand:fusi-tools.gitWorktree.refresh",
    "onCommand:fusi-tools.gitWorktree.openIntegratedTerminal",
    "onCommand:fusi-tools.gitWorktree.openExternalTerminal",
    "onCommand:fusi-tools.gitWorktree.pull",
    "onCommand:fusi-tools.gitWorktree.push",
    "onCommand:fusi-tools.gitWorktree.revealInExplorer",
    "onCommand:fusi-tools.gitWorktree.openInVsCode",
    "onCommand:fusi-tools.gitWorktree.createWorktree",
    "onCommand:fusi-tools.gitWorktree.deleteWorktree"
  ],
  "contributes": {
    "configuration": [
      {
        "id": "fusi-tools.gitWorktree",
        "title": "FT: Git Worktree",
        "properties": {
          "fusi-tools.gitWorktree.enabled": {
            "type": "boolean",
            "default": true,
            "order": 0,
            "markdownDescription": "启用或禁用 **Git 工作树管理** 功能 (需要重启)。\n\n管理 Git Worktrees，支持快速切换和操作。"
          }
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "fusi-tools.gitWorktree.view",
          "name": "工作树 (Worktrees)",
          "icon": "$(git-branch)",
          "when": "config.fusi-tools.gitWorktree.enabled",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "fusi-tools.gitWorktree.refresh",
        "title": "刷新工作树列表",
        "icon": "$(refresh)",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.openIntegratedTerminal",
        "title": "在内置终端中打开",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.openExternalTerminal",
        "title": "在外部终端中打开",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.pull",
        "title": "Pull",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.push",
        "title": "Push",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.revealInExplorer",
        "title": "在文件夹中打开",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.openInVsCode",
        "title": "在当前编辑器中打开",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.createWorktree",
        "title": "新建 Worktree",
        "icon": "$(add)",
        "category": "Fusi Tools"
      },
      {
        "command": "fusi-tools.gitWorktree.deleteWorktree",
        "title": "删除 Worktree",
        "icon": "$(trash)",
        "category": "Fusi Tools"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fusi-tools.gitWorktree.createWorktree",
          "when": "view == fusi-tools.gitWorktree.view",
          "group": "navigation@1"
        },
        {
          "command": "fusi-tools.gitWorktree.refresh",
          "when": "view == fusi-tools.gitWorktree.view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "fusi-tools.gitWorktree.createWorktree",
          "when": "view == fusi-tools.gitWorktree.view && viewItem == repository",
          "group": "inline"
        },
        {
          "command": "fusi-tools.gitWorktree.deleteWorktree",
          "when": "view == fusi-tools.gitWorktree.view && viewItem == worktree",
          "group": "inline"
        }
      ]
    }
  }
}
