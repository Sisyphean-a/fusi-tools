{
  "contributes": {
    "configuration": [
      {
        "id": "fusi-tools.smartTranslate",
        "title": "FT: Smart Translate",
        "properties": {
          "fusi-tools.smartTranslate.enabled": {
            "type": "boolean",
            "default": true,
            "order": 0,
            "markdownDescription": "启用/禁用 **智能翻译** 功能 (选中代码自动翻译/命名)。"
          },
          "fusi-tools.smartTranslate.displayDuration": {
            "type": "number",
            "default": 5000,
            "order": 1,
            "markdownDescription": "翻译结果显示时长 (毫秒)。"
          },
          "fusi-tools.smartTranslate.provider": {
            "type": "string",
            "enum": [
              "sisyphean",
              "google",
              "deeplx"
            ],
            "default": "sisyphean",
            "order": 2,
            "markdownDescription": "选择智能翻译使用的翻译源。",
            "enumDescriptions": [
              "当前内置翻译接口（fanyi.sisyphean.top）",
              "Google Translate 接口（translate.googleapis.com）",
              "DeepLX 接口（需要配置请求地址和 API Key）"
            ]
          },
          "fusi-tools.smartTranslate.deeplx.endpoint": {
            "type": "string",
            "default": "",
            "order": 3,
            "markdownDescription": "DeepLX 请求地址。示例：`https://api.deeplx.org/xxxxxx/translate`",
            "markdownAttributes": {
              "placeholder": "https://api.deeplx.org/xxxxxx/translate"
            }
          },
          "fusi-tools.smartTranslate.deeplx.apiKey": {
            "type": "string",
            "default": "",
            "order": 4,
            "markdownDescription": "DeepLX API Key。仅在翻译源选择 `deeplx` 时使用。",
            "markdownAttributes": {
              "placeholder": "your-api-key"
            }
          },
          "fusi-tools.smartTranslate.statusBarPosition": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "default": "right",
            "order": 5,
            "markdownDescription": "翻译状态栏位置。",
            "enumDescriptions": [
              "显示在状态栏左侧",
              "显示在状态栏右侧"
            ]
          }
        }
      }
    ],
    "commands": [
      {
        "command": "fusi-tools.toggleSmartTranslate",
        "title": "启用/禁用 智能翻译",
        "icon": "$(globe)",
        "category": "Fusi Tools"
      }
    ]
  }
}
